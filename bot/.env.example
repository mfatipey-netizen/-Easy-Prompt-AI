# Copy to `.env` and fill in ONLY when you decide to trade live.
# NEVER commit the real .env file. Data fetch + backtest + paper need none of these.

# --- Exchange API keys (live order execution only) ---
# Kraken:   https://www.kraken.com/u/security/api
# Coinbase: https://www.coinbase.com/settings/api  (Advanced Trade)
KRAKEN_API_KEY=
KRAKEN_SECRET=
COINBASE_API_KEY=
COINBASE_SECRET=
# Coinbase Advanced Trade may also require a passphrase depending on key type:
COINBASE_PASSWORD=

# --- Optional notifications ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK=
